# ==========================================
# smart-hire Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL with pgvector for prod; SQLite for local dev)
DATABASE_URL=sqlite:///./smart_hire.db
# DATABASE_URL=postgresql://smart_hire_user:smart_hire_password@localhost:5432/smart_hire
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Redis Cache & Distributed Rate Limiter
# REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=smart_hire_super_secret_jwt_key_2026_dev_env_x99
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Logging & Debugging
LOG_LEVEL=INFO
DEBUG=true

# Scheduler & Workers
WORKERS=2
RUN_SCHEDULER_IN_API=false

# Vector Search Backend ('local' with numpy or 'pgvector' with postgres)
VECTOR_BACKEND=local

# Job Ingestion Sources (Real APIs only)
RAPID_API_KEY=your_rapidapi_jsearch_key_here
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Optional Supabase Integration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-key
# DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Feature Flags
FEATURE_B2B_RECRUITER=true
SEED_DEMO=false

# Environment & Security
ENV=development
COOKIE_SECURE=false
ADMIN_TOKEN=smart-hire-admin-secret-token
ADMIN_INGEST_COOLDOWN_SECONDS=30

# Memory & Lightweight ML (Render Free Tier 512MB Budget)
ENABLE_HEAVY_ML=false

# Email Digest / Transactional Alerts (Resend HTTP API - zero SMTP dependencies)
# Leave RESEND_API_KEY blank to enable dry-run log mode
RESEND_API_KEY=
RESEND_FROM=smart-hire <notifications@smart-hire.app>
