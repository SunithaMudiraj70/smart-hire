{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (smart-hire backend)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "env": {
        "DEBUG": "true",
        "LOG_LEVEL": "DEBUG"
      }
    },
    {
      "name": "Chrome (smart-hire web)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/web"
    }
  ]
}

